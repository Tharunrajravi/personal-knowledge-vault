# Copy this to .env.local and fill in values
# This file is safe to commit — .env.local is gitignored

# AWS (for S3 uploads in local dev — use your real credentials)
# These are only needed if you want S3 uploads to work locally.
# For pure local dev, leave them blank and S3 features will be skipped.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_UPLOADS_BUCKET=pkv-uploads-919468641180
S3_FRONTEND_BUCKET=pkv-frontend-919468641180

# SES Email (leave disabled for local dev)
SES_ENABLED=false
SES_FROM_EMAIL=noreply@yourdomain.com

# App
APP_ENV=development
DEBUG=true
